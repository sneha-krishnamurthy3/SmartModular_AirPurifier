# =================================================================
# PAVITRA INNOVATIONS — ENVIRONMENT TEMPLATE (.env.example)
# Copy this file to .env and insert your real production keys.
# NOTE: Only public variables prefixed with VITE_ are exposed to the browser.
# =================================================================

# 1. FIREBASE AUTHENTICATION & FIRESTORE DATABASE
VITE_FIREBASE_API_KEY=your_firebase_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=your_app_id

# 2. RAZORPAY PAYMENT GATEWAY (FRONTEND PUBLIC KEY ONLY)
VITE_RAZORPAY_KEY_ID=your_razorpay_key_id

# -----------------------------------------------------------------
# SERVER-SIDE ONLY ENVIRONMENT VARIABLES (NEVER EXPOSE IN FRONTEND)
# Add this in your Vercel Dashboard -> Settings -> Environment Variables:
# -----------------------------------------------------------------
# RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# 3. EMAILJS AUTOMATED ORDER & ADMIN NOTIFICATIONS
VITE_EMAILJS_SERVICE_ID=your_emailjs_service_id
VITE_EMAILJS_TEMPLATE_ID=your_customer_email_template_id
VITE_EMAILJS_ADMIN_TEMPLATE_ID=your_admin_email_template_id
VITE_EMAILJS_PUBLIC_KEY=your_emailjs_public_key
